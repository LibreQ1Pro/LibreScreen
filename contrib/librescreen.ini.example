# librescreen.ini: every key is optional, the values below are the defaults.
# Looked up in: --config FILE, $LIBRESCREEN_CONFIG, ~/.config/librescreen/librescreen.ini, /etc/librescreen/librescreen.ini

[moonraker]
host = localhost
port = 7125

[screen]
port = /dev/ttyS1
baud = 115200
transfer_baud = 921600      ; speed of the firmware download (--flash-screen)

[paths]
data_dir = ~/.local/share/librescreen     ; settings.ini: the settings the screen saves
; Empty: asked from Moonraker, then ~/printer_data/{gcodes,config,logs}
gcodes =
config =
logs =

[log]
level = info                ; debug shows the chatty messages too
