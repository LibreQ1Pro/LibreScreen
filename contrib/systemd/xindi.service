# /etc/systemd/system/xindi.service
# Edit User= and the paths (the hardening below is not tried on a printer yet: if the service
# cannot reach something, loosen it), then: sudo systemctl enable --now xindi
[Unit]
Description=xindi: TJC screen backend for Klipper / Moonraker
After=moonraker.service NetworkManager.service
Wants=moonraker.service

[Service]
User=mks
SupplementaryGroups=dialout
WorkingDirectory=/home/mks/xindi
ExecStart=/usr/bin/python3 /home/mks/xindi/main.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mks/.local/share/xindi /home/mks/printer_data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
